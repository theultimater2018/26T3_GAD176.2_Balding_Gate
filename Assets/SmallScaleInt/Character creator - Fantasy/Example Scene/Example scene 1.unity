--- !u!114 &1547217251
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1547217249}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6ba1de4d682706438d4f663d3416339, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tooltipPanel: {fileID: 122683626}
  tooltipHeader: {fileID: 1806575334}
  tooltipContent: {fileID: 1965762730}
  tooltipWarning: {fileID: 0}
  headerText: Character outline
  contentText: "When enabled, an outline will be created around the character. The
    outline will be placed along the outside of the character. The slash, effects
    and the shadow will not recieve the outline. \n\nSolid outline: Creates a 1\u2011pixel
    solid colored outline around the character to make the character stand out from
    the environment. \n\nGlow: Creates a glow effect around the character. use the
    color picker to select a color and the slider to chose the size of the glow.\n\nGradient
    outline: When enabled, your character will receive a soft, 1\u2011pixel border
    that subtly picks up the colour of the nearest sprite pixels and lightens them.
    Instead of a harsh black stroke, each outline pixel samples its neighbour\u2019s
    hue and shifts it toward white, creating a gentle, integrated glow that helps
    your sprite stand out without clashing with its own palette. The gradient is
    NOT compatible with the color picker."
  warningText: 
  delayBeforeShow: 0.5
  fadeDuration: 0.2
