--- !u!114 &1977083478
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1977083476}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6ba1de4d682706438d4f663d3416339, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tooltipPanel: {fileID: 122683626}
  tooltipHeader: {fileID: 1806575334}
  tooltipContent: {fileID: 1965762730}
  tooltipWarning: {fileID: 0}
  headerText: Static idles
  contentText: "When enabled, all idle spritesheets (Idle, Idle2, Idle3, and CrouchIdle)
    are modified so that each directional row is made static. Instead of animating,
    each row is filled with 15 copies of its first frame, eliminating any subtle
    movement or jitter. This option is ideal for a more static visual design, ensuring
    the character appears completely still when idle. \n\nNote: The spritesheet still
    contains 15 frames per direction, but every frame in a row is identical."
  warningText: 
  delayBeforeShow: 0.5
  fadeDuration: 0.2
