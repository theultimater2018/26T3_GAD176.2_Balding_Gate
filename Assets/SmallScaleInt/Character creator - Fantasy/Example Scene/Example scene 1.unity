  tooltipWarning: {fileID: 0}
  headerText: Color palette
  contentText: "This toggle switches between two color options when randomizing.
    \n\nWhen turned OFF: The default is \"Any color\" and it picks a color at random
    for each piece of gear from the full color spectrum.\n\nWhen turned ON: The second
    option is to use the custom color palette which picks a color from a set of 30,
    that goes in the same dark fantasy style. "
  warningText: 
  delayBeforeShow: 0.5
  fadeDuration: 0.2
