  m_Name: 
  m_EditorClassIdentifier: 
  tooltipPanel: {fileID: 122683626}
  tooltipHeader: {fileID: 1806575334}
  tooltipContent: {fileID: 1965762730}
  tooltipWarning: {fileID: 0}
  headerText: Movement type
  contentText: 'This changes the input for moving the character around the preview
    window. Chose between:


    Relative to mouse: pressing the W key moves the
    character in the direction of the mouse.


    Click-to-move: Clicking somewhere
    on the ground makes the character move to that posistion.


    WASD: Move the
    character with the W, A, S and D keys in different directions. Mouse posistion
    har no input on movement.


    Cardinal: The character moves in the direction
    of the WASD keys but always faces the mouse cursor. '
  warningText: 
  delayBeforeShow: 0.5
  fadeDuration: 0.2
