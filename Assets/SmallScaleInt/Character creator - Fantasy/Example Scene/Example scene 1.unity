  m_Name: 
  m_EditorClassIdentifier: 
  tooltipPanel: {fileID: 122683626}
  tooltipHeader: {fileID: 1806575334}
  tooltipContent: {fileID: 1965762730}
  tooltipWarning: {fileID: 0}
  headerText: Generate spritesheets
  contentText: 'Clicking this button will begin the process of generating spritesheets
    based on your current character configuration. A separate spritesheet will be
    created for each animation and saved in the "Created Spritesheets" folder, located
    where you installed this asset. Each character will have its own dedicated subfolder
    to ensure previously generated data is not overwritten.


    Note: Spritesheet
    generation may take some time depending on your system. Please avoid closing
    the application or interrupting the process until the loading screen disappears
    to prevent data loss.


    The exact location of the spritesheets generated
    is: "SmallScaleInt/Character creator - Fantasy/Created Spritesheets". To change
    the output folder you need to edit it in the SpritesheetGenerator script in the
    CombineCharacterSpritesheetsCoroutine() method.  '
  warningText: 
  delayBeforeShow: 0.5
  fadeDuration: 0.2
